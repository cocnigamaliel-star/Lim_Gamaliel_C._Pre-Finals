<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RED//PORTFOLIO</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='20' fill='%23e62e2e'/><text x='50' y='68' font-size='55' text-anchor='middle' fill='white' font-family='Arial' font-weight='bold'>R</text></svg>" />
</head>
<body>
    <div class="bg-glow"></div>
    <header>
        <nav class="nav-shell">
            <div class="nav-inner">
                <a class="brand" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark">R<span class="brand-slash">//</span></span>
                    <span class="brand-text">PORTFOLIO</span>
                </a>
                <button class="nav-toggle" id="navToggle" aria-label="Toggle navigation"><i class="bi bi-list"></i></button>
                <div class="nav-links" id="navLinks">
                    <a class="nav-link" asp-controller="Home" asp-action="Index">Work</a>
                    <a class="nav-link" href="/#toc">Contents</a>
                    <a class="nav-link" href="/#about">About</a>
                    <a class="nav-link gh" href="https://github.com/cocnigamaliel-star" target="_blank" rel="noopener"><i class="bi bi-github"></i> GitHub</a>
                    @if (string.IsNullOrEmpty(Context.Session.GetString("Username")))
                    {
                        <a class="btn-login" asp-controller="Account" asp-action="Login"><i class="bi bi-box-arrow-in-right"></i> Login</a>
                    }
                    else
                    {
                        <span class="user-pill"><i class="bi bi-person-circle"></i> @Context.Session.GetString("Username")</span>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-logout"><i class="bi bi-box-arrow-right"></i> Logout</button>
                        </form>
                    }
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @if (TempData["Success"] != null)
        {
            <div class="flash-wrap"><div class="flash success"><i class="bi bi-check-circle-fill"></i> @TempData["Success"]</div></div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="flash-wrap"><div class="flash error"><i class="bi bi-exclamation-triangle-fill"></i> @TempData["Error"]</div></div>
        }
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="footer-inner">
            <div>
                <div class="brand mb-2"><span class="brand-mark">R<span class="brand-slash">//</span></span> <span class="brand-text">PORTFOLIO</span></div>
                <p class="foot-muted">Lim, Gamaliel · IT Elective 2 · Designed & built with ASP.NET Core MVC</p>
            </div>
            <div class="foot-links">
                <a href="https://github.com/cocnigamaliel-star" target="_blank" rel="noopener"><i class="bi bi-github"></i></a>
                <a href="https://linkedin.com" target="_blank" rel="noopener"><i class="bi bi-linkedin"></i></a>
                <a href="mailto:hello@example.com"><i class="bi bi-envelope-fill"></i></a>
            </div>
        </div>
        <div class="foot-base">&copy; 2026 RED//PORTFOLIO · <a asp-controller="Home" asp-action="Privacy">Privacy</a></div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.getElementById('navToggle')?.addEventListener('click', () =>
            document.getElementById('navLinks')?.classList.toggle('open'));
        setTimeout(() => document.querySelectorAll('.flash').forEach(f => { f.style.opacity = '0'; f.style.transition = 'opacity .5s'; setTimeout(() => f.remove(), 500); }), 4000);
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
